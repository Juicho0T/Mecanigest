DB_HOST=127.0.0.1
DB_PORT=3308
DB_NAME=mecanigest
DB_USER=root
DB_PASSWORD=
APP_NAME=MecaniGest
APP_DEMO=1

# Datos del taller que aparecen en la hoja de recepción, el presupuesto y el recibo
TALLER_NOMBRE=MecaniGest
TALLER_DIRECCION=
TALLER_TELEFONO=
TALLER_RFC=

# Tasa de IVA en porcentaje, aplicada solo a las órdenes donde se marque "Agregar IVA"
IVA_TASA=16

# Respaldos: cuántos conservar en storage/respaldos y carpeta opcional donde guardar una copia
# (por ejemplo una carpeta sincronizada de OneDrive o Google Drive: C:\Users\Taller\OneDrive\Respaldos)
RESPALDOS_CONSERVAR=30
RESPALDO_COPIA_DIR=
